{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./boardcore/tools/lint/boardcore-plugin.mjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "boardcore/no-chained-type-assertions": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "boardcore/**"
  ],
  "overrides": [
    {
      "files": [
        "packs/*/src/**"
      ],
      "rules": {
        "boardcore/determinism": "error",
        "boardcore/no-module-state": "error",
        "boardcore/only-sdk-imports": "error",
        "no-eval": "error"
      }
    }
  ]
}
